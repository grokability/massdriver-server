TIMES_TO_RUN=1000 # run this many times before exiting (or '1' to just run once)
DURATION_TO_RUN=3600 # seconds to run before exiting (Set to '1' to just run once)
SQS_QUEUE=https://sqs.us-east-2.amazonaws.com/999999999999/my-queue
AWS_REGION=us-east-2
#MAX_MESSAGES=10
MAX_CONCURRENCY=4
POLL_TIME=20
COMMAND_TEMPLATE="command_to_run for {TENANT} with {PAYLOAD} (and/or {B64PAYLOAD} which is the payload encoded in base-64)"
CRON_TEMPLATE="su -m {TENANT} -c /bin/sh {COMMANDLINE}"
MESSAGE_VISIBILITY_TIMEOUT=30
DIRECTORY_OF_ENV_VARS="/path/to/some/directory/{TENANT}"
#AWS_PROFILE=default # AWS_PROFILE means the access key and secret access key will both be ignored
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=

